{
  "name": "pbz",
  "version": "0.1.0",
  "type": "module",
  "description": "Unofficial CLI and JS library for Pixelblaze LED controllers. Compiles patterns headless, so you can keep them in git and iterate from an editor instead of a browser tab. Node 22+, zero dependencies.",
  "keywords": [
    "pixelblaze",
    "led",
    "ws2812",
    "ws2814",
    "addressable-leds",
    "rgbw",
    "electromage",
    "esp32",
    "cli",
    "nodejs",
    "zero-dependencies",
    "led-art"
  ],
  "license": "MIT",
  "author": "Tarek Rached",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tarekrached/pbz.git"
  },
  "homepage": "https://github.com/tarekrached/pbz#readme",
  "bugs": {
    "url": "https://github.com/tarekrached/pbz/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pbz": "./pbz.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "typecheck": "node test/typecheck.mjs",
    "smoke": "node test/smoke.mjs",
    "fixture": "node test/capture-fixture.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/pixelblaze.d.mts",
      "default": "./lib/pixelblaze.mjs"
    }
  },
  "files": [
    "pbz.mjs",
    "lib/",
    "examples/",
    "pb.config.example.json",
    "power.example.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "types": "./lib/pixelblaze.d.mts"
}
